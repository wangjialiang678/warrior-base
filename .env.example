# Copy to .env only for local work. Never commit credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data/live-local
LOCAL_DEMO=0
TRUST_PROXY=0
PHONE_HASH_SECRET=
DEPLOYMENT_DOMAINS=workbuddy.link,www.workbuddy.link
MODERATION_API_KEY=
MODERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODERATION_TEXT_MODEL=qwen-flash
MODERATION_VISION_MODEL=qwen3-vl-flash
MODERATION_DAILY_LIMIT=1000
# Optional custom moderation service instead of the Qwen adapter:
MODERATION_URL=
MODERATION_TOKEN=
